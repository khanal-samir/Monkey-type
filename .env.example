# Supabase (required for production / local DB + Realtime)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only secret for avatar uploads (never expose as VITE_*)
# SUPABASE_SECRET_KEY=your-service-role-or-secret-key

# Playwright / demo mode — in-memory fixtures (no live Supabase required)
# pnpm test:e2e sets these automatically via playwright.config.ts
# VITE_E2E_FIXTURES=1
# VITE_E2E_SHORT_TIMER=1
